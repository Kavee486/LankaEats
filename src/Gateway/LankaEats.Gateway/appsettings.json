{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Auth": {
    "EnableDemoLogin": true
  },
  "RateLimiting": {
    "PermitPerMinute": 120
  },
  "Jwt": {
    "Issuer": "lankaeats",
    "Audience": "lankaeats-api",
    "SigningKey": "dev-only-signing-key-change-me-0123456789abcdef"
  },
  "ReverseProxy": {
    "Routes": {
      "menu": {
        "ClusterId": "inventory",
        "RateLimiterPolicy": "per-client",
        "Match": { "Path": "/api/menu/{**rest}" }
      },
      "orders": {
        "ClusterId": "orders",
        "AuthorizationPolicy": "default",
        "RateLimiterPolicy": "per-client",
        "Match": { "Path": "/api/orders/{**rest}" }
      },
      "payments": {
        "ClusterId": "payments",
        "AuthorizationPolicy": "default",
        "RateLimiterPolicy": "per-client",
        "Match": { "Path": "/api/payments/{**rest}" }
      },
      "hubs": {
        "ClusterId": "notifications",
        "Match": { "Path": "/hubs/{**rest}" }
      }
    },
    "Clusters": {
      "orders": {
        "Destinations": { "primary": { "Address": "http://localhost:5101" } }
      },
      "inventory": {
        "Destinations": { "primary": { "Address": "http://localhost:5102" } }
      },
      "payments": {
        "Destinations": { "primary": { "Address": "http://localhost:5103" } }
      },
      "notifications": {
        "Destinations": { "primary": { "Address": "http://localhost:5104" } }
      }
    }
  }
}
